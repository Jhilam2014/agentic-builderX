{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QAgent Next Instruction Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "continue",
    "completion_score",
    "stop_reason",
    "gap_summary",
    "missing_items",
    "next_agent_type",
    "next_instruction",
    "validation_required",
    "memory_update",
    "iteration_control"
  ],
  "properties": {
    "continue": {
      "type": "boolean"
    },
    "completion_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "stop_reason": {
      "type": "string"
    },
    "gap_summary": {
      "type": "string"
    },
    "missing_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_agent_type": {
      "type": "string"
    },
    "next_instruction": {
      "type": "string"
    },
    "validation_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "memory_update": {
      "type": "object"
    },
    "iteration_control": {
      "type": "object"
    }
  }
}
