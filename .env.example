FRONTEND_PORT=5173
BACKEND_PORT=8080
GENERATED_SITE_PORT=5174
PROJECT_PORT_START=5300
PROJECT_PORT_END=5399
PROJECT_PREVIEW_PORT_RETRY_TIMEOUT_MS=120000
PROJECT_SELECT_PREVIEW_TIMEOUT_MS=15000
PROJECT_HOST_URL=http://localhost
PROJECT_RUNTIME_MODE=docker
PROJECT_RUNTIME_IMAGE=
PROJECT_RUNTIME_NETWORK=
PROJECTS_ROOT=/workspace/money/apps
PROJECTS_REGISTRY_PATH=/workspace/project/runtime/projects.json
PROJECT_EXPORTS_ROOT=/workspace/project/runtime/exports
PROJECTS_GITIGNORE_PATH=/workspace/money/.gitignore
VITE_BACKEND_URL=http://localhost:8080
VITE_GENERATED_SITE_URL=http://localhost:5174

# Agent runtime:
# - Local/default: auto detects VS Code/authenticated Codex first, then Claude Code.
# - Server/droplet: set AGENTIC_RUNTIME_TARGET=droplet and OPENAI_API_KEY; auto uses OpenAI API.
# - Force a provider with AI_CLI_PROVIDER=codex | claude | openai.
AGENTIC_RUNTIME_TARGET=local
AI_CLI_PROVIDER=auto
AI_CLI_BIN=
CLAUDE_BIN=claude
CODEX_BIN=codex

# Provider authentication modes:
# api_key | existing_cli_session | disabled
# Codex profile switching uses isolated CODEX_HOME directories under
# CODEX_PROFILES_ROOT. macOS example:
# CODEX_PROFILES_ROOT=/Users/<local-user>/.codex-profiles
CODEX_AUTH_MODE=existing_cli_session
CODEX_PROFILES_ROOT=
# Optional: force Codex CLI OAuth callback away from the BuilderX frontend/backend port.
CODEX_LOGIN_CALLBACK_PORT=1455
CODEX_LOGIN_CALLBACK_PROXY_PORT=1456
CODEX_PROFILE_REGISTRY_PATH=runtime/codex-profiles.json
CODEX_DEFAULT_PROFILE_ID=
CODEX_PROFILE_SELECTION_MODE=manual
CODEX_ALLOW_AUTOMATIC_PROFILE_FALLBACK=false
CODEX_PROFILE_FALLBACK_ORDER=
CODEX_PROFILE_MAX_FALLBACK_ATTEMPTS=1
CODEX_PROFILE_LIMIT_COOLDOWN_MINUTES=60
CLAUDE_AUTH_MODE=existing_cli_session

# Public application URL, including deployment base path when hosted.
PUBLIC_APP_URL=https://jhilamastro.com/agentic-builderX
AUTH_CALLBACK_BASE_URL=https://jhilamastro.com/agentic-builderX

ALLOW_SHARED_PROVIDER_KEY_FALLBACK=false
EXISTING_CLI_SESSION_ISOLATED=false

# Google SSO login
# Google Cloud Console OAuth Client must authorize the exact JavaScript origin
# used in the browser. Local default:
# http://localhost:5173
# Also add http://127.0.0.1:5173 only if you intentionally use that URL.
# This frontend uses Google Identity Services ID-token popup sign-in, so no
# out-of-band redirect URI is used by the app.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GENERATED_SITE_DIR=/workspace/generated-site
GENERATED_SITE_INTERNAL_URL=http://generated-site:5174
RESTART_GENERATED_CONTAINER=false
CODEX_WORKFLOW_TIMEOUT_MS=600000
NODE_ENV=development
ORCHESTRATOR_ARCHIVE_PATH=/workspace/project/orchestrator-temp/orchestrator-agent-001-main.zip
ORCHESTRATOR_INSTALL_ENABLED=true
ORCHESTRATOR_BOOTSTRAP_ENABLED=true
ORCHESTRATOR_BOOTSTRAP_TIMEOUT_MS=900000

# Orchestrator bootstrap additions
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
OPENAI_DEFAULT_MODEL=gpt-5
OPENAI_AGENT_VECTOR_STORE_ID=
OPENAI_AGENT_VECTOR_STORE_NAME=agent_knowledge_global
AGENT_MEMORY_ENABLED=true
AGENT_MEMORY_READ_ENABLED=true
AGENT_MEMORY_WRITE_ENABLED=true
AGENT_MEMORY_SYNC_ENABLED=true
AGENT_CAPABILITY_LEARNING_ENABLED=true
AGENT_KNOWLEDGE_DB_PROVIDER=firebase_data_connect
AGENT_KNOWLEDGE_DB_URL=
AGENT_KNOWLEDGE_DB_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_DATA_CONNECT_SERVICE_ID=
FIREBASE_DATA_CONNECT_LOCATION=
POSTGRES_URL=
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AGENT_GRAPH_DB_ENABLED=true
AGENT_GRAPH_DB_PROVIDER=neo4j
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
VECTOR_DB_PROVIDER=auto
VECTOR_DB_URL=
VECTOR_DB_API_KEY=
CHROMADB_URL=
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
CHROMADB_PERSIST_DIRECTORY=.chroma/agent-memory
APP_BASE_URL=
API_BASE_URL=
